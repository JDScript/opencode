{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jdscript/opencode-openviking",
  "version": "0.1.0",
  "description": "OpenViking long-term memory and repository retrieval for OpenCode v2",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDScript/opencode.git",
    "directory": "packages/plugin-openviking"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "vendor",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
